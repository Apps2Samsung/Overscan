<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tizen 6.0 package — covers the 2021-2023 sets (6.0, 6.5, 7.0).
    A package installs only where its manifest api-version is <= the TV's platform
    version, so the api-version 8.0 build is rejected on those sets with
    [118, -4]. This one declares 6.0 and therefore installs on 6.0 and upwards.

    Same ewk binding and shared source as Overscan4/Overscan5; the runtime on those
    platforms predates .NET 6, which is why this is a classic tizenXX target rather
    than the net6.0-tizen8.0 one.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen60</TargetFramework>
    <RootNamespace>Overscan</RootNamespace>
    <AssemblyName>Overscan</AssemblyName>
    <DebugType>portable</DebugType>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/common/**/*.cs" />
    <Compile Include="../src/elm/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The native probe, in the same three places as Overscan5 (see the comments
      there and NativeProbe): res/, bin/ beside Overscan.dll, and lib/. Issue #95
      was closed on the Q80's answer because this package did not carry it, and
      issue #105 is the same wall on another 6.0 set; this lets a Tizen 6 set
      answer for itself. The object is Overscan5's, referenced rather than copied,
      so there is one committed .so; res/ is therefore placed through the
      packaging task like lib/, since this project has no res/ folder of its own.
    -->
    <None Include="../Overscan5/res/libovprobe.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libovprobe.so</Link>
    </None>
    <TizenTpkUserIncludeFiles Include="../Overscan5/res/libovprobe.so">
      <TizenTpkSubDir>res</TizenTpkSubDir>
    </TizenTpkUserIncludeFiles>
    <TizenTpkUserIncludeFiles Include="../Overscan5/res/libovprobe.so">
      <TizenTpkSubDir>lib</TizenTpkSubDir>
    </TizenTpkUserIncludeFiles>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tizen.NET.Sdk" Version="1.1.9" />
    <PackageReference Include="Tizen.NET" Version="6.0.0.14995" />
  </ItemGroup>

</Project>
