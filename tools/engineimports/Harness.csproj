<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the shipping src/common/EngineImports.cs, unchanged, against a stand-in
    for the trail. A harness with its own copy of the code under test tests nothing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>engineimports</AssemblyName>
    <RootNamespace>Overscan.Harness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyVersion>0.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="../../src/common/EngineImports.cs" />
    <Compile Include="../../src/common/Deadline.cs" />
  </ItemGroup>

</Project>
